#!/bin/zsh

# 设置版本
TOMCAT_VERSION=9.0.85
TOMCAT_DIR=apache-tomcat-$TOMCAT_VERSION
TOMCAT_TAR=$TOMCAT_DIR.tar.gz
TOMCAT_URL=https://mirrors.tuna.tsinghua.edu.cn/apache/tomcat/tomcat-9/v$TOMCAT_VERSION/bin/$TOMCAT_TAR

echo "正在下载 Tomcat $TOMCAT_VERSION ..."
curl -L -O $TOMCAT_URL

if [[ ! -f $TOMCAT_TAR ]]; then
  echo "❌ 下载失败，文件未找到"
  exit 1
fi

echo "正在解压 Tomcat ..."
tar -xzf $TOMCAT_TAR || { echo "❌ 解压失败，压缩包可能损坏"; exit 1; }

echo "清理压缩包 ..."
rm $TOMCAT_TAR

echo "设置 TOMCAT_HOME 环境变量 ..."
echo "export TOMCAT_HOME=\$HOME/$TOMCAT_DIR" >> ~/.zshrc
echo 'export PATH=$TOMCAT_HOME/bin:$PATH' >> ~/.zshrc

echo "使配置立即生效 ..."
source ~/.zshrc

echo "✅ Tomcat $TOMCAT_VERSION 已配置完成"
echo "Tomcat 路径：$HOME/$TOMCAT_DIR"
echo "你现在可以运行 \$TOMCAT_HOME/bin/startup.sh 启动 Tomcat"